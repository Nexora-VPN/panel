# Copy to .env beside your docker-compose.yml (or merge these lines into the
# .env you already have for PostgreSQL) before starting the overlay.

# Grafana's own login. There is no default: an unset password would either
# refuse to start or start with a guessable one, and this dashboard shows every
# node you run.
GRAFANA_PASSWORD=change-me

# Optional. The username for that login.
#GRAFANA_USER=admin

# Optional. The address you actually open Grafana at. Leave it alone while you
# reach Grafana through an SSH tunnel; set it to the public URL — including any
# sub-path — once you put a reverse proxy in front.
#GRAFANA_ROOT_URL=https://grafana.example.com
