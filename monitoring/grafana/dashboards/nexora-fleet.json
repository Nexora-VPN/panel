{
  "title": "Nexora fleet",
  "description": "Nodes, accounts, licence headroom and the event bus, from the panel's /metrics. Every panel here is deliberately fleet- or node-level: the exposition carries no per-user label, so per-account questions belong to the panel's Reports page instead. Provisioned against the datasource uid `nexora-prometheus`; importing this file by hand into an existing Grafana needs a Prometheus datasource with that uid, or one find-and-replace.",
  "uid": "nexora-fleet",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nexora-prometheus"
        },
        "query": "label_values(nexora_node_up, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Nodes connected",
      "description": "Nodes whose last heartbeat connected, over the nodes the panel knows about.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(nexora_node_up)",
          "legendFormat": "up",
          "refId": "A"
        },
        {
          "expr": "nexora_nodes_total",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Accounts online",
      "description": "Accounts with traffic inside the panel's online window.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "nexora_users_online",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Panel uptime",
      "description": "Since the current panel process bound its listener. A drop to zero is a restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "time() - nexora_panel_start_time_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Accounts by status",
      "description": "One series per status, never per account.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "nexora_users_total",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Licence headroom",
      "description": "Rows against each cap. A cap of 0 is unlimited and reads as empty here.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "nexora_license_used / clamp_min(nexora_license_limit, 1)",
          "legendFormat": "{{resource}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Licence",
      "description": "1 while the licence checks out, 0 on the free tier or any invalid state. The panel keeps running either way — it downgrades, it never hard-blocks — so this is the metric that says a downgrade happened without anyone opening the panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "nexora_license_valid",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "free / invalid",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "licensed",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "type": "stat",
      "title": "Licence expires in",
      "description": "Absent when the licence does not expire. There is no grace period after the date, so this is the whole warning the fleet gets besides the panel's own banner.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "nexora_license_expires_at_seconds - time()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Panel build",
      "description": "The running version, from nexora_panel_build_info's label.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "nexora_panel_build_info",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "name",
        "colorMode": "none"
      }
    },
    {
      "type": "row",
      "title": "Nodes",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "Disk used",
      "description": "Absent for a node that does not report a disk total — an engine too old to say, or a platform without /proc. A gap here is the panel not knowing, never a disk that emptied.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "nexora_node_disk_used_bytes{node=~\"$node\"} / nexora_node_disk_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "description": "Same rule as disk: no series for a node that does not report a memory total.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "expr": "nexora_node_memory_used_bytes{node=~\"$node\"} / nexora_node_memory_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Load average (1m)",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "expr": "nexora_node_load1{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Traffic rate",
      "description": "Derived from the node's lifetime counters, so a node re-added from scratch shows a reset rather than a spike.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "rate(nexora_node_traffic_bytes_total{node=~\"$node\"}[5m])",
          "legendFormat": "{{node}} {{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Open connections",
      "description": "What each node's engine holds open. Absent while a node is not answering — which is what the panel's own uptime bar draws as an outage.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "expr": "nexora_node_connections{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Engine restarts",
      "description": "Counts since each node agent started, so the counter resets when the agent does.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "increase(nexora_node_engine_restarts_total{node=~\"$node\"}[1h])",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Event bus",
      "description": "The one panel failure that is otherwise silent: a delivery that never lands reports itself to nobody. A rising `dead`, or a `pending` that does not fall, is a stalled bus. `subscribers` at 0 means nothing is listening and an empty outbox is correct.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "expr": "nexora_event_deliveries",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "expr": "nexora_event_subscribers",
          "legendFormat": "subscribers",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Online accounts per node",
      "description": "Distinct accounts with traffic on each node inside the panel's online window. Absent while the usage series is switched off (stats_retention_days is 0) — which is why a flat line here and an empty panel are different answers.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "expr": "nexora_node_online_users{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Fleet state",
      "description": "`enabled` is the operator's switch; `up` is the last heartbeat. A node enabled but not up is an outage; one that is up but not enabled is serving nothing on purpose.",
      "datasource": {
        "type": "prometheus",
        "uid": "nexora-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "nexora_node_up",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "nexora_node_enabled",
          "legendFormat": "{{node}}",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "id 2": true
            },
            "renameByName": {
              "Value #A": "up",
              "Value #B": "enabled",
              "id 1": "id"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "yes",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": []
      }
    }
  ]
}
